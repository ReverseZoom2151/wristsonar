# Copy to .env and edit. Nothing here is a secret, and .env is not committed.
# Every variable is optional and the defaults shown are what the code uses when
# the variable is unset. The test suite must pass with none of these set.

# Where datasets, recordings and cached artifacts live. Nothing is downloaded
# automatically, so this directory may be missing or empty; the test suite does
# not read it.
# Default: ./data
WRISTSONAR_DATA_DIR=./data

# Audio device to use for capture and playback, as a name substring or a
# numeric index from the host audio backend. Only relevant when talking to real
# hardware. Leave unset to use the system default device.
# Default: unset, meaning the system default
WRISTSONAR_DEVICE=

# Sample rate in Hz for capture and playback. The sensing band is 18 to 21 kHz,
# so this has to stay above about 44100 to keep it below Nyquist with margin.
# 48000 is what stock smartwatch hardware actually runs at.
# Default: 48000
WRISTSONAR_SAMPLE_RATE=48000

# Logging verbosity. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Note that DEBUG may log signal statistics; it never logs raw audio, and it
# should not be made to.
# Default: INFO
WRISTSONAR_LOG_LEVEL=INFO
